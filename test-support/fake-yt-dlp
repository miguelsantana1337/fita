#!/usr/bin/env node
import { appendFile, mkdir, writeFile } from "node:fs/promises";
import path from "node:path";

const args = process.argv.slice(2);
const sleep = (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds));
if (process.env.FITA_FAKE_PID_LOG) {
  await appendFile(process.env.FITA_FAKE_PID_LOG, `${process.pid}\n`);
}

if (args.includes("--flat-playlist")) {
  if (String(args.at(-1)).includes("very-slow")) await sleep(30_000);
  if (String(args.at(-1)).includes("slow")) await sleep(1_000);
  process.stdout.write(JSON.stringify({
    id: "playlist-fixture",
    title: "Playlist de teste",
    entries: [
      { id: "fixture-one", title: "Faixa fixture um" },
      { id: "fixture-two", title: "Faixa fixture dois" },
    ],
  }));
  process.exit(0);
}

if (args.includes("--dump-single-json")) {
  process.stdout.write(JSON.stringify({
    id: "fixture-single",
    title: "Faixa fixture",
    channel: "Canal de teste",
    duration: 12,
    thumbnail: null,
    webpage_url: args.at(-1),
  }));
  process.exit(0);
}

const url = new URL(args.at(-1));
const id = url.searchParams.get("v") || url.pathname.split("/").filter(Boolean).at(-1) || "fixture";
if (id.includes("cancel-delay")) {
  process.on("SIGTERM", () => setTimeout(() => process.exit(143), 500));
  await sleep(30_000);
}
if (id.includes("very-slow")) await sleep(30_000);
if (id.includes("slow")) await sleep(1_000);
if (id.includes("fail")) {
  process.stderr.write("ERROR: Falha controlada da fixture\n");
  process.exit(1);
}

const formatIndex = args.indexOf("--audio-format");
const outputIndex = args.indexOf("--output");
const format = args[formatIndex + 1];
const directory = path.dirname(args[outputIndex + 1]);
const title = `Faixa ${id}`;
const filePath = path.join(directory, `${title} [${id}].${format}`);
await mkdir(directory, { recursive: true });
process.stdout.write(`__FITA_TITLE__:${title}\n`);
process.stdout.write("download: 25%| 1.0MiB/s|00:03\n");
await sleep(30);
process.stdout.write("download: 75%| 1.1MiB/s|00:01\n");
await writeFile(filePath, `audio-fixture:${id}`);
process.stdout.write(`__FITA_FILE__:${filePath}\n`);
process.exit(0);
